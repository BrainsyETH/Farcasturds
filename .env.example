# Neynar API - Required for Farcaster functionality
NEYNAR_API_KEY=your_neynar_api_key_here

# Coinbase CDP API - Required for Onchain Reputation Score (Base)
CDP_API_KEY_NAME=your_cdp_api_key_name_here
CDP_API_KEY_PRIVATE_KEY=your_cdp_api_key_private_key_here

# Base RPC URL (optional - defaults to public endpoint)
BASE_RPC_URL=https://mainnet.base.org

# Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Vercel (if using Vercel KV/Postgres/Blob)
KV_URL=your_kv_url
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token
POSTGRES_URL=your_postgres_url
