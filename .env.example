# Neynar API - Required for Farcaster functionality
NEYNAR_API_KEY=your_neynar_api_key_here

# Talent Protocol API - Required for Builder Score (Base reputation)
TALENT_PROTOCOL_API_KEY=your_talent_protocol_api_key_here

# Base RPC URL (optional - defaults to public endpoint)
BASE_RPC_URL=https://mainnet.base.org

# Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Vercel (if using Vercel KV/Postgres/Blob)
KV_URL=your_kv_url
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token
POSTGRES_URL=your_postgres_url
